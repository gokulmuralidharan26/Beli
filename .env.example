# Copy to .env (gitignored) and fill in.

# Google Cloud -> APIs & Services -> enable "Places API (New)" -> Credentials -> API key
GOOGLE_PLACES_API_KEY=

# Optional but recommended: your home city. Used to disambiguate lookups when the
# statement doesn't include a city (Apple Card never does).  e.g. "Austin, TX"
HOME_LOCATION=

# Reserved for the optional Beli auto-push step (not built yet).
BELI_REFRESH_TOKEN=
